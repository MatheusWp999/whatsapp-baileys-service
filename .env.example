PORT=3000
NODE_ENV=production
LOG_LEVEL=info
API_TOKEN=change-me

# Folder for Baileys auth state (must be persisted)
BAILEYS_SESSION_DIR=/data/sessions
BAILEYS_INSTANCE_PREFIX=crm-

# Required Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Message retention
WHATSAPP_LINKED_RETENTION_DAYS=90
WHATSAPP_UNLINKED_RETENTION_DAYS=90
WHATSAPP_MEDIA_MAX_BYTES=15000000

# Durable outbound campaign worker (run exactly one service replica)
WHATSAPP_CAMPAIGN_WORKER_ENABLED=false
WHATSAPP_CAMPAIGN_POLL_MS=2000
